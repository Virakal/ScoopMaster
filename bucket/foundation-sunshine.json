{
    "version": "2026.1125",
    "description": "Self-hosted game streaming host for Moonlight (Foundation fork: HDR10/HDR Vivid, virtual displays, desktop control panel).",
    "homepage": "https://github.com/AlkaidLab/foundation-sunshine",
    "license": "GPL-3.0-only",
    "notes": [
        "Upstream ships this host as an installer; this package unpacks the portable ZIP, which upstream recommends only for special cases such as running several instances.",
        "Run install_portable.bat / uninstall_portable.bat from the app directory as administrator to install or remove the Windows service, firewall rules and the optional virtual-display / gamepad drivers.",
        "The Start menu shortcut starts sunshine.exe elevated (UAC prompt); finish the first-run wizard at https://localhost:47990/ afterwards.",
        "Settings, app list and pairing data live in $dir\\config (persisted across updates).",
        "Uninstalling leaves two admin-only leftovers created by Sunshine itself: the persisted config folder (its local-auth.token is owned by Administrators) and the firewall rules named sunshine.exe / Sunshine. Remove both from an elevated prompt."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/AlkaidLab/foundation-sunshine/releases/download/v2026.1125.34136.%E6%9D%82%E9%B1%BC/Sunshine.v2026.1125.Portable-x64.zip",
            "hash": "cf885bc39b2ef25a55be778ec1b88bdc2503f94b32460c78022827769c9cd2ce"
        }
    },
    "extract_dir": "Sunshine",
    "bin": [
        "sunshine.exe",
        "assets\\gui\\sunshine-gui.exe"
    ],
    "shortcuts": [
        [
            "sunshine.exe",
            "Sunshine"
        ]
    ],
    "post_install": [
        "$lnks = @(\"$([Environment]::GetFolderPath('StartMenu'))\\Programs\\Scoop Apps\\Sunshine.lnk\", \"$([Environment]::GetFolderPath('CommonStartMenu'))\\Programs\\Scoop Apps\\Sunshine.lnk\") | Where-Object { Test-Path $_ }",
        "foreach ($lnk in $lnks) { $bytes = [System.IO.File]::ReadAllBytes($lnk); if (($bytes[0x15] -band 0x20) -eq 0) { $bytes[0x15] = $bytes[0x15] -bor 0x20; [System.IO.File]::WriteAllBytes($lnk, $bytes) } }",
        "$layers = 'HKCU:\\Software\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers'",
        "$null = New-Item -Path $layers -Force",
        "(Get-ItemProperty -Path $layers).PSObject.Properties | Where-Object { $_.Name -like '*\\foundation-sunshine\\*' -and $_.Name -ne \"$dir\\sunshine.exe\" } | ForEach-Object { Remove-ItemProperty -Path $layers -Name $_.Name -ErrorAction SilentlyContinue }",
        "Set-ItemProperty -Path $layers -Name \"$dir\\sunshine.exe\" -Value '~ RUNASADMIN' -Type String"
    ],
    "post_uninstall": [
        "$layers = 'HKCU:\\Software\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers'",
        "if (Test-Path $layers) { (Get-ItemProperty -Path $layers).PSObject.Properties | Where-Object { $_.Name -like '*\\foundation-sunshine\\*' } | ForEach-Object { Remove-ItemProperty -Path $layers -Name $_.Name -ErrorAction SilentlyContinue } }"
    ],
    "persist": "config",
    "checkver": {
        "url": "https://api.github.com/repos/AlkaidLab/foundation-sunshine/releases/latest",
        "regex": "\"tag_name\":\\s*\"v([0-9]{4}\\.[0-9]{4})\\.([0-9]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AlkaidLab/foundation-sunshine/releases/download/v$version.$match2.%E6%9D%82%E9%B1%BC/Sunshine.v$version.Portable-x64.zip"
            }
        }
    }
}

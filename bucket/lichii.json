{
    "version": "410",
    "description": "VERY experimental Nintendo Switch 2 emulator, forked from yuzu and Eden (PGO build).",
    "homepage": "https://github.com/zortos293/Lichii",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://github.com/zortos293/Lichii/raw/nx2/LICENSE.txt"
    },
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "url": "https://github.com/zortos293/Lichii/releases/download/build-410/lichii-windows-x86_64-pgo.zip",
    "hash": "1234366a25122496607ad1ec3d65ee2ee680e82ab4a350e07af2c91e917b04e1",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\user\")) {",
        "    New-Item \"$persist_dir\\user\" -ItemType Directory -Force | Out-Null",
        "    if (Test-Path \"$env:APPDATA\\lichii\") {",
        "        if (Get-Process lichii -ErrorAction SilentlyContinue) {",
        "            warn 'Lichii is running, so its %APPDATA%\\lichii profile was not copied into the portable user directory.'",
        "        } else {",
        "            Write-Host 'Copying %APPDATA%\\lichii into the portable user directory...' -ForegroundColor Yellow",
        "            Copy-Item -Path \"$env:APPDATA\\lichii\\*\" -Destination \"$persist_dir\\user\" -Recurse -Force -ErrorAction Continue",
        "            warn 'The old profile in %APPDATA%\\lichii was kept as a copy; Lichii now uses the portable user directory.'",
        "        }",
        "    }",
        "}"
    ],
    "bin": [
        [
            "lichii.exe",
            "lichii"
        ],
        [
            "eden-cli.exe",
            "lichii-cli"
        ]
    ],
    "shortcuts": [
        [
            "lichii.exe",
            "Lichii"
        ]
    ],
    "persist": "user",
    "checkver": {
        "github": "https://github.com/zortos293/Lichii",
        "regex": "build-(\\d+)"
    },
    "autoupdate": {
        "url": "https://github.com/zortos293/Lichii/releases/download/build-$version/lichii-windows-x86_64-pgo.zip",
        "hash": {
            "url": "https://api.github.com/repos/zortos293/Lichii/releases/tags/build-$version",
            "jsonpath": "$.assets[?(@.name == '$basename')].digest"
        }
    }
}

{
    "##": "ltguillaume/schep",
    "version": "3.2.0",
    "description": "Share sensitive information securely with client-side encryption and self-destructing messages. Portable.",
    "homepage": "https://skysend.app",
    "license": {
        "identifier": "AGPL-3.0-only",
        "url": "https://github.com/Skyfay/SkySend/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Skyfay/SkySend/releases/download/v3.2.0/skysend-windows-x64.exe#/skysend.exe",
            "hash": "3508cdfdae49e30eb074fc28c6afddde22e7590777fd70909f4d48d06a6c0904"
        }
    },
    "bin": "skysend.exe",
    "shortcuts": [
        [
            "skysend.exe",
            "SkySend"
        ]
    ],
    "post_install": [
        "if (-not (Test-Path \"$Env:UserProfile\\.config\\skysend\\*\")) {",
        "    Remove-Item \"$Env:UserProfile\\.config\\skysend\" 2>$null",
        "    if (-not (Test-Path \"$persist_dir\")) {",
        "        New-Item -ItemType \"directory\" -Path \"$persist_dir\" >$null",
        "    }",
        "    New-DirectoryJunction \"$Env:UserProfile\\.config\\skysend\" \"$persist_dir\" >$null",
        "}"
    ],
    "pre_uninstall": [
        "$skysend_data = Get-Item \"$Env:UserProfile\\.config\\skysend\"",
        "if (\"$($skysend_data.Target)\" -eq \"$persist_dir\") { $skysend_data.Delete() }"
    ],
    "checkver": {
        "github": "https://github.com/Skyfay/SkySend"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Skyfay/SkySend/releases/download/v$version/skysend-windows-x64.exe#/skysend.exe"
            }
        }
    }
}

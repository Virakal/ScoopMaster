{
    "version": "1.10.0",
    "description": "An open-source desktop client for Hongguo short dramas.",
    "homepage": "https://github.com/zfdang/hongguo-open-player",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zfdang/hongguo-open-player/releases/download/v1.10.0/hongguo-open-player-1.10.0-win-x64.zip",
            "hash": "cbed0e6e87f051a8c1dceeb123fc7be0f6489ac6905211920f8b4ab14d3f2ba1"
        }
    },
    "shortcuts": [
        [
            "红果开源播放器.exe",
            "Hongguo Open Player",
            "--user-data-dir=\"$persist_dir\\data\""
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/zfdang/hongguo-open-player"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zfdang/hongguo-open-player/releases/download/v$version/hongguo-open-player-$version-win-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}

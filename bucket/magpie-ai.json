            "hash": "55d6b0ef4bbb27cb59279006031f73c6a2c522f4183fee828b1b01898eb0c50d"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.3007/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "0d34cbfbcf0e60bdf58b0eae92aec2ba7fbf73f7cd56a35cf84a9ce9079dbd6e"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {

        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1731/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "07dffbe85055eabe2578efafec62701c5505cbee22eb3f059dcc427cc7a8548a"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",

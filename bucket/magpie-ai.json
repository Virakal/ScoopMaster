            "hash": "aa7ec4033e940fb86e0a85d466491ac12ab580929afa8b25009137153cfcf9b4"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.4401/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "2e932952a1eb5260b8224640ff7b0530aaf9b90c3030511232f7e0f9e96279ed"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },

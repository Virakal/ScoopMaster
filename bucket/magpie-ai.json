            "hash": "9bca50079452c4870ef5b92523a2bb41f58eee5fb2afbb84853c7cc33b5a3a3a"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.4505/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "f4721d145c1055b3d6ff950b84e81970b8f2e9da66fa86c90e47c2d58caaf56a"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },

            "hash": "235b38fbfce978b1c1703cdd85911b15ddca67e92aeabb0535b4731cc08eec6c"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",

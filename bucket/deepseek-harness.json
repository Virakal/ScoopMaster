{
    "version": "0.2.0-rc.2",
    "description": "Desktop application for DeepSeek Harness (dsh), an open-source agent harness built on an everything-is-a-plugin architecture",
    "homepage": "https://www.deepseek.com/harness/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.0-rc.2-win-x64.exe#/dl.7z",
            "hash": "sha512:ada225c4c41df44497824b665625bb43054b723051e4922cacd3aef92a5e958f24b24752af61f9d7f7fe7b2d44a8523f78822b2900ae44034c79be52a6d45972",
            "installer": {
                "script": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal"
            }
        }
    },
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*.exe\", \"$dir\\7zip-installer-*.txt\" -Force -Recurse -ErrorAction SilentlyContinue",
    "persist": ".dsh",
    "env_set": {
        "DSH_HOME": "$persist_dir\\.dsh"
    },
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness",
            "--user-data-dir=\"$persist_dir\\electron-profile\""
        ]
    ],
    "notes": [
        "dsh's data root (sessions, profiles, attachments, credentials) is redirected to '$persist_dir\\.dsh' through the DSH_HOME environment variable, so it lives in Scoop's persist directory and survives updates.",
        "The Electron profile (Local Storage, keybindings, logs) is redirected to '$persist_dir\\electron-profile' through a '--user-data-dir' argument on the Start Menu shortcut; launching the .exe directly skips that switch.",
        "The desktop app has its own nightly updater; prefer 'scoop update deepseek-harness' so the install and this manifest stay in sync."
    ],
    "checkver": {
        "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
        "regex": "version:\\s*([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
                    "regex": "sha512:\\s*(?:>-)?\\s*$base64"
                }
            }
        }
    }
}

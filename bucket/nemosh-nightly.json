            "(Invoke-WebRequest -UseBasicParsing -Headers $headers -Uri 'https://api.github.com/repos/xiongnemo/nemosh/releases').Content"
        ],
        "regex": "(?s)\"tag_name\":\\s*\"v(?<version>[^\"]+-master-[0-9a-f]+)\"(?:(?!\\\"tag_name\\\").)*?\"name\":\\s*\"nemosh-v\\k<version>-windows-amd64\\.zip\""
    },
    "autoupdate": {

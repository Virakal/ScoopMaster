{
    "version": "0.3.6",
    "description": "Native SSH workspace with SFTP, port forwarding, remote desktops and an AI assistant.",
    "homepage": "https://github.com/t8y2/motty",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.3.6/motty-0.3.6-windows-amd64.zip",
            "hash": "8b178106c80e85279b3c7acb7e682ad42b57cc910121eedd00dcc1cde9790fe7"
        },
        "arm64": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.3.6/motty-0.3.6-windows-arm64.zip",
            "hash": "78f160153ee97b9afa6a7de7d7ce85d62ca9f007251a6da36b8d8bce74b5405a"
        }
    },
    "pre_install": [
        "# Work around Motty's path canonicalization failing on Scoop directory junctions.",
        "$launcher = @('@echo off', 'setlocal DisableDelayedExpansion', 'if defined GODEBUG (set \"GODEBUG=%GODEBUG%,winsymlink=0\") else (set \"GODEBUG=winsymlink=0\")')",
        "$launcher + @('\"%~dp0motty.exe\" %*', 'exit /b %errorlevel%') | Set-Content -LiteralPath \"$dir\\motty.cmd\" -Encoding ASCII",
        "$launcher + 'start \"\" \"%~dp0motty.exe\" %*' | Set-Content -LiteralPath \"$dir\\motty-gui.cmd\" -Encoding ASCII"
    ],
    "bin": "motty.cmd",
    "shortcuts": [
        [
            "motty-gui.cmd",
            "Motty",
            "",
            "motty.exe"
        ]
    ],
    "persist": "motty-data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/t8y2/motty/releases/download/v$version/motty-$version-windows-arm64.zip"
            }
        }
    }
}

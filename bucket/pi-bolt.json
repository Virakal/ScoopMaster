    "license": "MIT",
    "notes": "Update with 'scoop update pi-bolt'. Sessions and settings are in ~\\.pi and stay when Pi-Bolt is uninstalled.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/opensec-git/Pi-Bolt/releases/download/bolt-v1.0.1/pi-bolt-win32-x64.zip",
            "hash": "171170caed9c4831fd6bb24c98c7e17f72fd3735546114f625fdd21c8e5d43be",
            "extract_dir": "pi-bolt-win32-x64"
        }
    },
    "bin": "pi-bolt.exe",
    "checkver": {
        "github": "https://github.com/opensec-git/Pi-Bolt",
        "regex": "bolt-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/opensec-git/Pi-Bolt/releases/download/bolt-v$version/pi-bolt-win32-x64.zip",
                "extract_dir": "pi-bolt-win32-x64"
            }
        },
        "hash": {
            "url": "https://github.com/opensec-git/Pi-Bolt/releases/download/bolt-v$version/SHA256SUMS",
            "regex": "$sha256\\s+\\*?$basename"
        }
    }
}

{
    "version": "nightly",
    "description": "600+ free PowerShell scripts for Linux, macOS, and Windows.",
    "homepage": "https://github.com/fleschutz/PowerShell",
    "license": "CC0-1.0",
    "suggest": {
        "Markdown Docs Viewer": "main/glow"
    },
    "url": "https://github.com/fleschutz/PowerShell/archive/master.zip",
    "extract_dir": "PowerShell-main",
    "pre_install": "'.github', 'gui', 'LICENSE', 'README.md' | ForEach-Object { Remove-Item \"$dir\\$_\" -Force -Recurse }",
    "env_add_path": "scripts",
    "env_set": {
        "FLESCHUTZ_PS": "$original_dir"
    }
}
